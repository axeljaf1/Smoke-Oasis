<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#090b0b">
<title>BANNA JELLY — Plant Experience</title>
<style>
:root{--lime:#c6ff00;--purple:#d82bff;--ink:#080a0a;--panel:#111515;--muted:#9aa39b;--line:#293128}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ink);color:#f5f7ee;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 18% 12%,#4bff0012,transparent 38%),radial-gradient(ellipse at 90% 38%,#d82bff12,transparent 35%);z-index:-1}
button{font:inherit;cursor:pointer}.wrap{max-width:1040px;margin:auto;padding:0 22px}.nav{display:flex;align-items:center;justify-content:space-between;padding:20px 0;border-bottom:1px solid #ffffff12}.brand{font-size:13px;letter-spacing:.22em;font-weight:900}.brand span{color:var(--lime)}.pill{border:1px solid #405032;background:#10170b;color:var(--lime);padding:8px 12px;border-radius:99px;font-size:11px;letter-spacing:.1em}
.hero{min-height:680px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:30px;padding:55px 0 65px;position:relative}.eyebrow{color:var(--lime);font-size:11px;letter-spacing:.24em;font-weight:800;text-transform:uppercase}.hero h1{font-size:clamp(54px,9vw,108px);line-height:.82;letter-spacing:-.075em;margin:20px 0 22px;font-weight:1000;text-transform:uppercase}.hero h1 span{display:block;color:var(--purple);text-shadow:4px 4px 0 #671080}.intro{color:#b5beb3;max-width:430px;line-height:1.7;font-size:15px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.btn{border:0;border-radius:13px;padding:14px 18px;font-weight:800;font-size:13px;transition:.2s}.btn:hover{transform:translateY(-2px)}.primary{background:var(--lime);color:#111}.secondary{background:#191f1a;color:#fff;border:1px solid #34402d}.art{min-height:460px;display:grid;place-items:center;position:relative;isolation:isolate}.orb{position:absolute;width:min(390px,90%);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 28%,#d7ff54,#5b9e00 38%,#18220d 70%);filter:drop-shadow(0 0 55px #a4ff0029);animation:float 5s ease-in-out infinite;z-index:-1}.banana{font-size:clamp(150px,26vw,255px);filter:drop-shadow(10px 20px 0 #0008);animation:float 4s ease-in-out infinite;transform:rotate(-10deg);user-select:none}.ring{position:absolute;width:95%;aspect-ratio:1;border:1px solid #baff3b55;border-radius:50%;animation:spin 24s linear infinite}.ring:before,.ring:after{content:"✦";position:absolute;color:var(--purple);font-size:25px}.ring:before{top:8%;left:18%}.ring:after{right:8%;bottom:20%;color:var(--lime)}.sticker{position:absolute;bottom:9%;right:1%;padding:12px 14px;background:#111;border:1px solid var(--lime);border-radius:12px;transform:rotate(5deg);font-size:12px;font-weight:900;box-shadow:5px 5px 0 var(--purple)}.sticker small{display:block;color:var(--lime);font-size:9px;letter-spacing:.18em}
.section{padding:65px 0;border-top:1px solid #ffffff12}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}.section h2{font-size:clamp(28px,5vw,48px);letter-spacing:-.05em;margin:10px 0 0}.muted{color:var(--muted);font-size:13px;line-height:1.6}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.card{background:linear-gradient(145deg,#151b15,#0e1110);border:1px solid var(--line);border-radius:18px;padding:20px;min-height:160px;transition:.25s}.card:hover{transform:translateY(-4px);border-color:#8cb52b}.icon{font-size:25px;margin-bottom:18px}.card h3{margin:0 0 8px;font-size:15px}.card p{margin:0;color:#aab3a8;font-size:12px;line-height:1.65}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.chip{border:1px solid #3b4835;color:#d7e6ca;border-radius:99px;padding:8px 11px;font-size:11px;background:#101510}.chip.active{background:var(--lime);color:#101510;border-color:var(--lime)}
.explorer{display:grid;grid-template-columns:.8fr 1.2fr;gap:18px}.tabs{display:flex;flex-direction:column;gap:9px}.tab{border:1px solid var(--line);border-radius:12px;padding:15px;text-align:left;background:#101411;color:#c3cbbf}.tab b{display:block;font-size:13px}.tab small{display:block;margin-top:4px;color:#849080;font-size:11px}.tab.active{border-color:var(--lime);background:#18200f;color:#fff;box-shadow:inset 3px 0 var(--lime)}.detail{min-height:260px;background:linear-gradient(145deg,#151b15,#0b0e0c);border:1px solid var(--line);border-radius:18px;padding:26px;animation:fade .35s}.detail .num{font-size:11px;letter-spacing:.2em;color:var(--lime)}.detail h3{font-size:30px;letter-spacing:-.04em;margin:12px 0}.detail p{color:#aeb8ab;line-height:1.8;font-size:14px;max-width:570px}.meter{height:6px;background:#293128;border-radius:99px;margin:15px 0;overflow:hidden}.meter span{display:block;height:100%;background:linear-gradient(90deg,var(--lime),var(--purple));width:70%;border-radius:99px}
.timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.step{padding:16px;border-top:2px solid var(--lime);background:#111611;border-radius:0 0 12px 12px}.step strong{font-size:12px}.step p{font-size:11px;line-height:1.6;color:#9da79a}.footer{padding:30px 0 50px;color:#737e70;font-size:11px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.modal{position:fixed;inset:0;background:#000b;display:none;place-items:center;padding:20px;z-index:5;backdrop-filter:blur(10px)}.modal.show{display:grid}.modal-box{width:min(440px,100%);background:#121712;border:1px solid #52633c;border-radius:22px;padding:27px;text-align:center;animation:pop .3s}.scanbox{width:160px;height:160px;border:2px solid var(--lime);border-radius:18px;margin:20px auto;display:grid;place-items:center;position:relative;overflow:hidden;background:repeating-linear-gradient(0deg,#0c110c 0 8px,#121b11 8px 16px)}.scanbox:after{content:"";position:absolute;height:3px;left:8px;right:8px;top:10px;background:var(--lime);box-shadow:0 0 18px var(--lime);animation:scan 2s ease-in-out infinite}.scanbox span{font-size:48px}.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);opacity:0;background:var(--lime);color:#111;padding:12px 16px;border-radius:12px;font-size:12px;font-weight:900;transition:.3s;z-index:8;pointer-events:none}.toast.show{opacity:1;transform:translate(-50%,0)}
@keyframes float{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-15px) rotate(3deg)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes scan{0%,100%{top:8px}50%{top:145px}}@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes pop{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:scale(1)}}
@media(max-width:720px){.hero{grid-template-columns:1fr;padding:50px 0 35px;gap:0;min-height:auto}.hero-copy{order:1}.art{order:0;min-height:290px}.orb{width:250px}.banana{font-size:175px}.ring{width:280px}.sticker{bottom:4%;right:8%}.hero h1{font-size:68px}.grid{grid-template-columns:1fr 1fr}.explorer{grid-template-columns:1fr}.tabs{display:grid;grid-template-columns:1fr 1fr}.timeline{grid-template-columns:1fr 1fr}.section{padding:45px 0}.section-head{align-items:start;flex-direction:column}.nav{padding:16px 0}}@media(max-width:390px){.grid{grid-template-columns:1fr}.hero h1{font-size:58px}.tabs{grid-template-columns:1fr}.timeline{grid-template-columns:1fr 1fr}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
<header class="nav"><div class="brand">B<span>✦</span>J / EXPERIENCE</div><span class="pill">QR ID · BJ-001</span></header>
<main>
<section class="hero" id="inicio">
<div class="hero-copy"><div class="eyebrow">Colección botánica · 001</div><h1>BANNA<span>JELLY</span></h1><p class="intro">Una experiencia digital para explorar el perfil, los aromas y la historia de esta variedad. Escanea, descubre y explora cada detalle.</p><div class="actions"><button class="btn primary" onclick="document.querySelector('#explorar').scrollIntoView({behavior:'smooth'})">Explorar variedad ↘</button><button class="btn secondary" onclick="openScan()">✦ Escaneo QR</button></div><div class="chips"><span class="chip">#BannaJelly</span><span class="chip">Perfil de variedad</span><span class="chip">BJ-001</span></div></div>
<div class="art" aria-label="Ilustración animada de banana"><div class="ring"></div><div class="orb"></div><div class="banana">🍌</div><div class="sticker"><small>IDENTIDAD DIGITAL</small>SCAN THE VIBE ↗</div></div>
</section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Ficha de identidad</div><h2>Conoce el perfil.</h2></div><p class="muted">Datos de muestra para la demo.<br>Personaliza la ficha con información verificada.</p></div>
<div class="grid">
<article class="card"><div class="icon">🌿</div><h3>Perfil botánico</h3><p>Nombre de colección: Banna Jelly. El linaje y la composición exactos deben confirmarse con el productor.</p></article>
<article class="card"><div class="icon">🍌</div><h3>Notas aromáticas</h3><p>Perfil conceptual para la demo: plátano dulce, fruta tropical y un fondo cremoso.</p><div class="chips"><span class="chip">Frutal</span><span class="chip">Dulce</span></div></article>
<article class="card"><div class="icon">🧪</div><h3>Ficha de laboratorio</h3><p>Los valores de cannabinoides, terpenos y lote se mostrarán aquí cuando existan resultados de laboratorio.</p><div class="meter"><span style="width:45%"></span></div><p>Datos pendientes de verificación</p></article>
</div></section>
<section class="section" id="explorar"><div class="section-head"><div><div class="eyebrow">Explorador interactivo</div><h2>Abre cada capítulo.</h2></div><p class="muted">Toca una tarjeta para descubrir más.</p></div>
<div class="explorer"><div class="tabs" role="tablist">
<button class="tab active" onclick="showDetail(0,this)"><b>01 / Aroma</b><small>Notas sensoriales</small></button>
<button class="tab" onclick="showDetail(1,this)"><b>02 / Terpenos</b><small>Perfil químico</small></button>
<button class="tab" onclick="showDetail(2,this)"><b>03 / Cultivo</b><small>Origen y lote</small></button>
<button class="tab" onclick="showDetail(3,this)"><b>04 / Trazabilidad</b><small>Identidad del producto</small></button>
</div><div class="detail" id="detail" aria-live="polite"><div class="num">CAPÍTULO 01</div><h3>Una firma frutal.</h3><p>La dirección creativa de esta ficha imagina un perfil dulce y tropical. Las notas aromáticas reales pueden variar según el lote, el curado y el almacenamiento; sustituye este texto por la evaluación sensorial verificada del producto.</p><div class="chips"><span class="chip active">Fruta</span><span class="chip">Dulzor</span><span class="chip">Cremoso</span></div></div></div>
</section>
<section class="section"><div class="section-head"><div><div class="eyebrow">De la planta al perfil</div><h2>La historia del lote.</h2></div></div><div class="timeline">
<div class="step"><strong>01 · Origen</strong><p>Productor y ubicación del cultivo por añadir.</p></div><div class="step"><strong>02 · Cosecha</strong><p>Fecha y número de lote por verificar.</p></div><div class="step"><strong>03 · Análisis</strong><p>Resultados de laboratorio y certificado, si existen.</p></div><div class="step"><strong>04 · Identidad</strong><p>QR único conectado a la ficha digital.</p></div>
</div></section>
<section class="section"><div class="section-head"><div><div class="eyebrow">Tu recorrido</div><h2>¿Qué quieres descubrir?</h2></div></div><div class="grid">
<button class="card" onclick="showDetail(0,document.querySelectorAll('.tab')[0]);document.querySelector('#explorar').scrollIntoView({behavior:'smooth'})"><div class="icon">👃</div><h3>Explorar aromas ↗</h3><p>Descubre el perfil sensorial de la ficha.</p></button>
<button class="card" onclick="showDetail(1,document.querySelectorAll('.tab')[1]);document.querySelector('#explorar').scrollIntoView({behavior:'smooth'})"><div class="icon">🔬</div><h3>Ver composición ↗</h3><p>Consulta datos verificados cuando estén disponibles.</p></button>
<button class="card" onclick="copyID()"><div class="icon">▦</div><h3>Copiar ID del producto ↗</h3><p>Identificador demo: BANNA-JELLY-BJ001.</p></button>
</div></section>
</main>
<footer class="footer"><span>© BANNA JELLY · EXPERIENCIA DIGITAL CONCEPTUAL</span><span>Demo UI · BJ-001 · Información ilustrativa</span></footer>
</div>
<div class="modal" id="scanModal" role="dialog" aria-modal="true" aria-labelledby="scanTitle"><div class="modal-box"><div class="eyebrow">QR IDENTIFICADOR · BJ-001</div><h2 id="scanTitle">¡Ficha desbloqueada!</h2><p class="muted">Así puede sentirse la experiencia después de escanear el código de tu etiqueta.</p><div class="scanbox"><span>🍌</span></div><p class="muted">Banna Jelly · Perfil botánico interactivo</p><button class="btn primary" onclick="closeScan();document.querySelector('#explorar').scrollIntoView({behavior:'smooth'})">Entrar a la experiencia ↗</button><button class="btn secondary" style="margin-left:6px" onclick="closeScan()">Cerrar</button></div></div>
<div class="toast" id="toast">ID copiado</div>
<script>
const details=[
{n:'CAPÍTULO 01',title:'Una firma frutal.',body:'La dirección creativa de esta ficha imagina un perfil dulce y tropical. Las notas aromáticas reales pueden variar según el lote, el curado y el almacenamiento; sustituye este texto por la evaluación sensorial verificada del producto.',chips:['Fruta','Dulzor','Cremoso']},
{n:'CAPÍTULO 02',title:'Terpenos, con transparencia.',body:'Aquí se mostrará el perfil de terpenos únicamente cuando exista un análisis válido del lote. No se inventan porcentajes: añade el certificado, la fecha de análisis y el laboratorio para convertir esta sección en una ficha confiable.',chips:['Análisis de lote','Certificado','Trazabilidad']},
{n:'CAPÍTULO 03',title:'Cada lote tiene una historia.',body:'Registra el origen, el productor, la fecha de cosecha y los procesos posteriores. Esta demo usa campos ilustrativos; completa la información real antes de publicar la página para clientes.',chips:['Origen por añadir','Cosecha por añadir','Lote BJ-001']},
{n:'CAPÍTULO 04',title:'Un QR. Una identidad.',body:'El identificador BANNA-JELLY-BJ001 es de demostración. En producción, cada etiqueta puede enlazar a una URL propia para mostrar su ficha y, si se requiere, distinguir lotes mediante un ID único.',chips:['ID único','Ficha digital','URL por configurar']}
];
function showDetail(i,btn){document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));if(btn)btn.classList.add('active');const d=details[i];document.getElementById('detail').innerHTML=`<div class="num">${d.n}</div><h3>${d.title}</h3><p>${d.body}</p><div class="chips">${d.chips.map((c,j)=>`<span class="chip ${j===0?'active':''}">${c}</span>`).join('')}</div>`;}
function openScan(){document.getElementById('scanModal').classList.add('show');}
function closeScan(){document.getElementById('scanModal').classList.remove('show');}
function copyID(){if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText('BANNA-JELLY-BJ001').then(toast).catch(()=>toast())}else toast()}
function toast(){const t=document.getElementById('toast');t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800)}
document.getElementById('scanModal').addEventListener('click',e=>{if(e.target.id==='scanModal')closeScan()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeScan()});
</script>
</body></html>
